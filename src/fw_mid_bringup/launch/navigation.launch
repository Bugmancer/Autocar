<launch>
  <!-- 默认使用项目实验室地图对；更换地图时同步核对 PCD、二维地图及初始位姿。 -->
  <arg name="map_pcd" default="$(find fw_mid_localizer)/maps/underground/map.pcd" />
  <arg name="map_yaml_path" default="$(find fw_mid_global_planner)/maps/underground/map_2d.yaml" />
  <!-- 初值默认取地图原点，实际行驶前需通过重定位或 RViz 校准。 -->
  <arg name="initial_pose" default="[0,0,0,0,0,0]" />
  <arg name="start_lidar" default="true" />
  <arg name="takeover_video_address" default="true" />
  <arg name="start_lio" default="true" />
  <!-- 默认禁用实车 CAN 输出；开启前仍需满足控制链各级定位和传感器有效性检查。 -->
  <arg name="enable_can" default="false" />
  <arg name="start_rviz" default="false" />
  <arg name="can_interface" default="can0" />
  <arg name="max_vx" default="0.05" />
  <arg name="max_wz" default="5.0" />
  <!-- 三个独立跟随节点三选一；follower_node 保留旧调用兼容并可覆盖策略映射。 -->
  <arg name="follower_variant" default="classic" />
  <arg name="follower_node" default="$(eval {'classic': 'path_follower_node.py', 'apf': 'path_follower_node_v1.py', 'v3': 'path_follower_node_v3.py'}[arg('follower_variant')])" />
  <arg name="body_to_base_link" default="0.28991 0.0 -0.81317 0.0 -0.785398 0.0" />
  <arg name="lio_config" default="$(find fw_mid_fastlio2)/config/lio.yaml" />
  <arg name="localizer_config" default="$(find fw_mid_localizer)/config/localizer.yaml" />
  <arg name="planner_config" default="$(find fw_mid_local_planner)/config/local_planner.yaml" />
  <arg name="geometry_config" default="$(find fw_mid_common_utils)/config/collision_geometry.yaml" />

  <include if="$(arg start_lidar)" file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch">
    <arg name="takeover_video_address" value="$(arg takeover_video_address)" />
  </include>
  <include if="$(arg start_lio)" file="$(find fw_mid_fastlio2)/launch/lio.launch">
    <arg name="config_path" value="$(arg lio_config)" />
  </include>
  <include file="$(find fw_mid_localizer)/launch/localizer.launch">
    <arg name="map_pcd" value="$(arg map_pcd)" />
    <arg name="initial_pose" value="$(arg initial_pose)" />
    <arg name="config_path" value="$(arg localizer_config)" />
  </include>
  <include file="$(find fw_mid_global_planner)/launch/global_planner.launch">
    <arg name="geometry_config" value="$(arg geometry_config)" />
    <arg name="map_yaml_path" value="$(arg map_yaml_path)" />
  </include>
  <include file="$(find fw_mid_local_planner)/launch/local_planner.launch">
    <arg name="geometry_config" value="$(arg geometry_config)" />
    <arg name="config_file" value="$(arg planner_config)" />
    <arg name="body_to_base_link" value="$(arg body_to_base_link)" />
    <arg name="require_localization" value="true" />
    <arg name="max_vx" value="$(arg max_vx)" />
    <arg name="max_wz" value="$(arg max_wz)" />
    <arg name="follower_node" value="$(arg follower_node)" />
    <arg name="follower_variant" value="$(arg follower_variant)" />
  </include>
  <include file="$(find fw_mid_ctrl)/launch/navigation_driver.launch">
    <arg name="start_can" value="$(arg enable_can)" />
    <arg name="can_interface" value="$(arg can_interface)" />
    <arg name="max_vx" value="$(arg max_vx)" />
    <arg name="max_wz" value="$(arg max_wz)" />
  </include>

  <!-- 可选可视化；项目配置包含期望运动方向箭头。 -->
  <node if="$(arg start_rviz)" pkg="rviz" type="rviz"
        name="navigation_rviz"
        args="-d $(find fw_mid_localizer)/rviz/localizer.rviz"
        output="screen" />
</launch>
