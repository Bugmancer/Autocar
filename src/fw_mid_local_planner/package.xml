<?xml version="1.0"?>
<package format="2">
  <name>fw_mid_local_planner</name>
  <version>0.1.0</version>
  <description>ROS1 local path tracking and dynamic-obstacle overlay for FW-mid.</description>
  <maintainer email="robot@todo.todo">robot</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>fw_mid_common_utils</depend>
  <depend>fw_mid_controller</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
</package>
