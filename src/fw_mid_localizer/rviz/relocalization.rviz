Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 30
    - Alpha: 1
      Class: rviz/PointCloud2
      Color: 190; 190; 190
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Map Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 1
      Style: Points
      Topic: /localizer/map_cloud
    - Alpha: 1
      Class: rviz/PointCloud2
      Color: 40; 220; 130
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Accepted Aligned Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Style: Points
      Topic: /localizer/aligned_cloud
    - Alpha: 1
      Axes Length: 0.6
      Axes Radius: 0.05
      Class: rviz/Pose
      Color: 255; 100; 40
      Enabled: true
      Head Length: 0.25
      Head Radius: 0.12
      Name: Localized Body Pose
      Shaft Length: 0.7
      Shaft Radius: 0.06
      Shape: Arrow
      Topic: /localizer/pose
    - Class: rviz/Axes
      Enabled: true
      Length: 1
      Name: Map Axes
      Radius: 0.05
      Reference Frame: map
    - Class: rviz/Axes
      Enabled: true
      Length: 0.5
      Name: Body Axes
      Radius: 0.03
      Reference Frame: body
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Name: Current View
      Pitch: 1.2
      Target Frame: <Fixed Frame>
      Yaw: 5.2
