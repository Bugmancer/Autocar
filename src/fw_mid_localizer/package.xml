<?xml version="1.0"?>
<package format="2">
  <name>fw_mid_localizer</name>
  <version>0.1.0</version>
  <description>ROS1/Noetic ICP map localizer for the FW-mid vehicle.</description>
  <maintainer email="robot@todo.todo">Autocar maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>

  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>message_runtime</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>fw_mid_fastlio2</exec_depend>

  <export>
    <build_type>catkin</build_type>
  </export>
</package>
