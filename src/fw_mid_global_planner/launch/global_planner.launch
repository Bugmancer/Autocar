<launch>
  <arg name="map_yaml_path" default="$(find fw_mid_global_planner)/maps/underground/map_2d.yaml" />
  <arg name="map_frame" default="map" />
  <arg name="geometry_config" default="$(find fw_mid_common_utils)/config/collision_geometry.yaml" />
  <arg name="dynamic_obstacle_topic" default="/local_planner/dynamic_obstacle_points" />
  <arg name="enable_dynamic_overlay" default="true" />

  <node pkg="fw_mid_global_planner"
        type="astar_planner_node.py"
        name="astar_planner_node"
        output="screen">
    <rosparam command="load" file="$(arg geometry_config)" />
    <param name="map_yaml_path" value="$(arg map_yaml_path)" />
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="allow_unknown" value="false" />
    <param name="enable_forbidden_zones" value="false" />
    <param name="cluster_radius_px" value="2" />
    <param name="min_cluster_area_px" value="300" />
    <param name="max_cluster_area_px" value="3000" />
    <param name="max_forbidden_width_m" value="2.0" />
    <param name="max_forbidden_height_m" value="2.0" />
    <param name="enable_dynamic_overlay" value="$(arg enable_dynamic_overlay)" />
    <param name="dynamic_obstacle_topic" value="$(arg dynamic_obstacle_topic)" />
    <!-- Session memory is replaced explicitly, never expired out of blind spots. -->
    <param name="dynamic_overlay_timeout" value="0.0" />
  </node>
</launch>
